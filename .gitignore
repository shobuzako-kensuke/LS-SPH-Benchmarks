# Ignore VSCode settings
**/.vscode/

# Ignore calculation results, figures, research, references directories 
**/figures/
**/results/
**/research/
**/references/

# Ignore build directories and intermediate files
**/build/
**/*.mod
**/*.o

# Ignore Python cache files
**/__pycache__/

# Ignore the compiled executable file
**/start_calculation
**/start_calculation.exe

# Ignore Intel Fortran optimization reports
**/*.optrpt

# Ignore Windows Zone.Identifier files
# See [https://qiita.com/zakoken/items/61141df6aeae9e3f8e36]
**/*Zone.Identifier

# Ignore LaTeX source code and intermediate files
**/*.tex
**/*.bib
**/*.aux
**/*.bbl
**/*.blg
**/*.dvi
**/*.fdb_latexmk
**/*.fls
**/*.log
**/*.out
**/*.synctex.gz
**/*.toc
**/*.idx
**/*.ind
**/*.ilg

# Ignore virtual environment
.venv/
